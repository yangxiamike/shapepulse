{
  "schema_version": "shape-v2-research/1",
  "dataset_version": "shape-v2.0.0-draft1",
  "status": "definition_review",
  "formal_scoring_enabled": false,
  "source": {
    "provider": "local_zer0share",
    "network_allowed": false,
    "price_adjustment": "qfq_as_of_scoring_date"
  },
  "sample": {
    "window_bars": 120,
    "minimum_bars": 120,
    "price_anchor": 100.0,
    "price_normalization": "first_adjusted_close",
    "volume_normalization": "median_nonzero_volume",
    "public_fields": [
      "t",
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "hidden_fields": [
      "ts_code",
      "symbol",
      "name",
      "industry",
      "trade_date",
      "score_date"
    ]
  },
  "split_policy": {
    "group_unit": "source_security",
    "calibration_isolated": true,
    "weights": {
      "template": 0.5,
      "tuning": 0.25,
      "final_evaluation": 0.25
    },
    "final_evaluation_policy": "sealed_once"
  },
  "categories": [
    {
      "key": "fresh_breakout",
      "label": "刚突破",
      "definition": "评分日附近刚刚有效越过一段可辨认的压力区，仍处于突破初段，而不是已经远离平台后的加速末段。",
      "core_evidence": [
        "突破前存在可辨认的整理或压力区",
        "收盘价站上压力区，或突破后少量交易日内仍守住",
        "量能与价格行为至少不互相矛盾",
        "离中期均线和突破位的距离仍处合理范围"
      ],
      "core_contradictions": [
        "没有可辨认的压力区或突破位",
        "评分日已经明显跌回突破位下方",
        "突破发生已久且价格严重过度延伸",
        "实际是下跌趋势中的单日反弹"
      ],
      "feature_keys": [
        "breakout_vs_prior_20",
        "breakout_vs_prior_60",
        "return_5",
        "return_20",
        "ma20_extension",
        "volume_ratio_5_20",
        "trend_slope_20",
        "trend_fit_20",
        "volatility_20",
        "days_since_60_high"
      ]
    },
    {
      "key": "healthy_uptrend",
      "label": "健康上升趋势",
      "definition": "评分日处于持续、可辨认且不过度失真的上升结构中；高低点、均线、斜率和回撤共同支持趋势仍健康。",
      "core_evidence": [
        "中短期斜率为正，且走势不是仅靠一两根异常K线抬高",
        "价格大体运行在中期均线之上，均线结构有序",
        "阶段回撤受控，没有破坏主要上升结构",
        "波动、乖离和量价状态不过度极端"
      ],
      "core_contradictions": [
        "中期趋势斜率已经转负",
        "价格持续跌破主要趋势支撑且未收复",
        "结构主要由极端跳涨或单点尖峰构成",
        "实际是长期下跌后的弱反弹"
      ],
      "feature_keys": [
        "return_20",
        "return_60",
        "return_119",
        "trend_slope_20",
        "trend_slope_60",
        "trend_slope_120",
        "trend_fit_20",
        "trend_fit_60",
        "trend_fit_120",
        "ma20_extension",
        "ma60_extension",
        "ma_alignment",
        "drawdown_60",
        "drawdown_120",
        "volatility_20",
        "volatility_60",
        "positive_day_ratio_60"
      ]
    },
    {
      "key": "pullback_strengthening",
      "label": "回调转强",
      "definition": "此前已有上升基础，随后发生真实但未破坏主结构的回调，评分日附近出现止跌、收复或动能重新转强的证据。",
      "core_evidence": [
        "回调前存在可辨认的上升段",
        "中间确实发生回撤，而不是一路直线上涨",
        "评分日附近出现更高低点、均线收复或短期动能转正等转强证据",
        "转强发生时主要趋势尚未被严重破坏"
      ],
      "core_contradictions": [
        "回调前没有上升基础",
        "评分日仍在连续走弱或创阶段新低",
        "回撤已经破坏中期趋势且只是弱反抽",
        "没有经历回调，实际只是刚突破或持续上行"
      ],
      "feature_keys": [
        "prior_return_60_ex_last_10",
        "drawdown_20",
        "drawdown_60",
        "return_3",
        "return_5",
        "rebound_from_10_low",
        "ma10_extension",
        "ma20_extension",
        "close_location_5",
        "volume_ratio_5_20",
        "up_down_volume_ratio_20",
        "trend_slope_60",
        "trend_fit_60"
      ]
    }
  ],
  "label_scale": {
    "0": "不相关或存在核心矛盾；若进入榜单前列属于严重错误",
    "1": "有局部相似，但缺少关键结构或有明显缺陷",
    "2": "相关且可用，主要结构成立，但不是理想代表",
    "3": "高度相关，可作为该类别的代表性模板样本"
  },
  "scoring_draft": {
    "architecture": "shared_facts_plus_three_independent_scorers",
    "distance": "weighted_euclidean",
    "template_statistics": [
      "median",
      "q25",
      "q75",
      "robust_scale"
    ],
    "weights": null,
    "minimum_scores": null,
    "note": "定义卡和标注标准确认前不启用正式评分。"
  }
}
