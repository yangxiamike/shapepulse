{
  "schema_version": "shape-v2-research/1",
  "dataset_version": "shape-v2.0.0-draft2",
  "status": "targeted_calibration",
  "formal_scoring_enabled": false,
  "source": {
    "provider": "local_zer0share",
    "network_allowed": false,
    "price_adjustment": "qfq_as_of_scoring_date"
  },
  "sample": {
    "window_bars": 120,
    "minimum_bars": 120,
    "price_anchor": 100.0,
    "price_normalization": "first_adjusted_close",
    "volume_normalization": "median_nonzero_volume",
    "public_fields": [
      "t",
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "hidden_fields": [
      "ts_code",
      "symbol",
      "name",
      "industry",
      "trade_date",
      "score_date",
      "selection_profile"
    ]
  },
  "split_policy": {
    "group_unit": "source_security",
    "calibration_isolated": true,
    "weights": {
      "template": 0.5,
      "tuning": 0.25,
      "final_evaluation": 0.25
    },
    "final_evaluation_policy": "sealed_once"
  },
  "targeted_calibration": {
    "sample_count": 24,
    "candidate_count": 360,
    "public_order": "anonymous_hash",
    "profile_quotas": {
      "breakout_clean_confirmed": 3,
      "breakout_day_unconfirmed": 2,
      "breakout_downtrend_lookalike": 2,
      "breakout_near_boundary": 3,
      "trend_clean": 3,
      "trend_old_high": 2,
      "trend_overextended": 1,
      "trend_range_boundary": 1,
      "pullback_shallow_confirmed": 2,
      "pullback_deep_fast": 2,
      "pullback_long_stale": 2,
      "pullback_moderate": 1
    },
    "note": "这些分层只用于构造校准题，不是正式分类规则，也不会显示给标注者。"
  },
  "categories": [
    {
      "key": "fresh_breakout",
      "label": "刚突破",
      "definition": "评分日附近刚刚有效越过一段可辨认的压力区；突破当天原则上最高2分，突破后1至3根K线仍守住压力位才可达到3分。",
      "rating_anchors": {
        "0": "没有有效突破。",
        "1": "只有局部影子，例如下跌趋势反弹、平台不清或单日突拉。",
        "2": "突破清楚但发生在T0当天尚未确认，或确认质量略弱。",
        "3": "清晰突破已发生1至3根K线，价格守住突破位且量价和背景结构协调。"
      },
      "core_contradictions": [
        "没有可辨认的压力区或突破位",
        "突破后已明显跌回压力位下方",
        "实际是中期下跌趋势中的反弹",
        "突破发生已久且价格严重过度延伸"
      ],
      "feature_keys": [
        "breakout_age",
        "breakout_hold_margin",
        "breakout_confirmed",
        "breakout_day_return",
        "breakout_volume_ratio",
        "pre_breakout_volatility_20",
        "largest_up_day_share_20",
        "breakout_vs_prior_20",
        "breakout_vs_prior_60",
        "trend_slope_60",
        "trend_fit_60",
        "ma20_extension"
      ]
    },
    {
      "key": "healthy_uptrend",
      "label": "健康上升趋势",
      "definition": "评分日处于持续、有序且不过度失真的上升结构中；接近更早的显著前高但尚未突破时属于软扣分，不是硬排除。",
      "rating_anchors": {
        "0": "中期趋势已经转弱、长期横盘或只是下跌后的反弹。",
        "1": "仅有局部上升，趋势连续性和结构质量较弱。",
        "2": "健康趋势成立，但存在旧前高受阻、过度延伸或波动偏大等缺陷。",
        "3": "多周期趋势连续，回撤受控，未在重要旧前高处明显停滞。"
      },
      "core_contradictions": [
        "中期趋势斜率已经转负",
        "价格持续跌破主要趋势支撑且未收复",
        "结构主要由极端跳涨或单点尖峰构成",
        "上升发生已久且当前已演化为大区间"
      ],
      "feature_keys": [
        "return_20",
        "return_60",
        "return_119",
        "trend_slope_20",
        "trend_slope_60",
        "trend_slope_120",
        "trend_fit_20",
        "trend_fit_60",
        "trend_fit_120",
        "ma20_extension",
        "ma60_extension",
        "ma_alignment",
        "drawdown_60",
        "drawdown_120",
        "old_high_gap_120",
        "days_since_old_high",
        "old_high_rejection_count",
        "range_staleness_60"
      ]
    },
    {
      "key": "pullback_strengthening",
      "label": "回调转强",
      "definition": "此前已有上升基础，随后发生未完全破坏主结构的真实回调，并在评分日附近出现止跌、收复或动能重新转强；深、急、久分别软扣分。",
      "rating_anchors": {
        "0": "回调前没有上升基础、仍在创新低，或已经长期拖成区间。",
        "1": "能看出上升后回调，但过深、过急、过久或转强证据很弱。",
        "2": "回调转强结构成立，但深度、时间或确认质量并不理想。",
        "3": "此前趋势清楚，回调浅至适中、时间受控，且出现明确转强确认。"
      },
      "core_contradictions": [
        "回调前没有可辨认的上升基础",
        "评分日仍在连续走弱或创阶段新低",
        "回撤已经破坏中期趋势且只是弱反抽",
        "回调持续过久并已演化为大区间"
      ],
      "feature_keys": [
        "prior_advance_before_peak",
        "drawdown_20",
        "drawdown_60",
        "pullback_duration_60",
        "pullback_speed_60",
        "worst_5day_return_20",
        "retracement_of_prior_advance",
        "turn_confirmation",
        "return_3",
        "return_5",
        "rebound_from_10_low",
        "ma10_extension",
        "ma20_extension",
        "trend_slope_60",
        "trend_fit_60",
        "range_staleness_60"
      ]
    }
  ],
  "label_scale": {
    "0": "不相关或存在核心矛盾；若进入榜单前列属于严重错误",
    "1": "有局部相似，但缺少关键结构或有明显缺陷",
    "2": "相关且可用，主要结构成立，但不是理想代表",
    "3": "高度相关，可作为该类别的代表性模板样本"
  },
  "scoring_draft": {
    "architecture": "shared_facts_plus_three_independent_scorers",
    "distance": "weighted_euclidean",
    "template_statistics": [
      "median",
      "q25",
      "q75",
      "robust_scale"
    ],
    "weights": null,
    "minimum_scores": null,
    "note": "C2仍只用于人工校准，不启用正式评分。"
  }
}
